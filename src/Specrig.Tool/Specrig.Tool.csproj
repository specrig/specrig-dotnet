<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>specrig</ToolCommandName>
    <Description>The specrig dotnet tool: init lays a specification-first suite out beside a service; surface, agents and rules keep its records, its specrig.md and its modes current.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Specrig.Surface/Specrig.Surface.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Specrig.Tool.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../protocol/modes.yaml" LogicalName="protocol/modes.yaml" />
    <EmbeddedResource Include="../../protocol/agents/*.md" LogicalName="protocol/agents/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
