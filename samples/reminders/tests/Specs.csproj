<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Reminders.Specs</AssemblyName>
    <RootNamespace>Reminders.Specs</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Reqnroll.xunit.v3" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Reminders.csproj" />
    <ProjectReference Include="../../../src/Specrig.Reqnroll/Specrig.Reqnroll.csproj" />
    <ProjectReference Include="../../../src/Specrig.RabbitMQ/Specrig.RabbitMQ.csproj" />
    <ProjectReference Include="../../../src/Specrig.Quartz/Specrig.Quartz.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Update="reqnroll.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
