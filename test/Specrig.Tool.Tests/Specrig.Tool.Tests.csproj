<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Specrig.Tool/Specrig.Tool.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../protocol/fixtures/agents/**" LinkBase="agents" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../protocol/fixtures/markers/**" LinkBase="markers" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
